package frc.robot.commands;

import java.util.function.Supplier;

import edu.wpi.first.wpilibj2.command.Command;
import edu.wpi.first.wpilibj2.command.InstantCommand;
import frc.robot.subsystems.Intake;
import edu.wpi.first.wpilibj.Timer;

public class IntakeJitterCommand {

    Indexer intake;
    Supplier<Boolean> isActive;
    Supplier<Double> shakePos;
    Timer timer;


    public IntakeJitterCommand(Intake intake, Supplier<Boolean> isActive, Supplier<Double> shakePos) {
        this.intake = intake;
        this.isActive = isActive;
        this.shakePos = shakePos;

        this.timer = new Timer(); // redundant? idk the this keyword is for better readability

        addRequirements(intake);
    }

    public void changeIntakePos(double value) {
        shakePos = () -> value;
    }

    public void jitter() {
        if (timer.get() > 0.15) { // activate if the timer is a whole number
            changeRollerSpeed(-shakePos.get()); // set roller speed to negative itself
            timer.reset();
        }
    }

    public Supplier<Double> getPos() {
        return shakePos;
    }

     @Override
    public void initialize() {
        timer.reset();
        timer.start(); 
    }

    @Override
    public void execute() {
        jitter();
        intake.setDeployPosition((),    );
    }

    @Override
    public void end(boolean interrupted) {
        
    }

    // Returns true when the command should end.
    @Override
    public boolean isFinished() {
        return false;
    }

    @Override
    public InterruptionBehavior getInterruptionBehavior() {
        return InterruptionBehavior.kCancelSelf;
    }

}